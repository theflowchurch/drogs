  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "playwright": "^1.62.1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@supabase/supabase-js": "^2.117.2",
    "mysql2": "^3.24.4",
    "next": "16.3.6",
    "nodemailer": "^10.0.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.4",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=22.0.0"
  }
