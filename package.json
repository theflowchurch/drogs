{
  "name": "drogs",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "node scripts/serve-export.mjs",
    "test:browser": "python3 tests/registration/browser.py",
    "test:api": "node --test tests/api.test.mjs",
    "api:key": "node scripts/create_api_key.mjs",
    "predev": "node scripts/prepare-public.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/prepare-public.mjs",
    "build": "next build",
    "test": "node --test tests/registration/*.test.mjs",
