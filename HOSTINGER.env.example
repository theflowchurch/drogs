# Hostinger Node.js application: set these at BUILD and RUNTIME.
NEXT_PUBLIC_REGISTRATION_BACKEND=mysql
NEXT_PUBLIC_BASE_PATH=
APP_URL=https://kuriakecastle.org

# MySQL — full database name and username from Hostinger.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# For a remote TLS-enabled MySQL server, use true (and CA if needed).
DB_SSL=false
DB_SSL_CA=

# Comma-separated verified email addresses allowed to administer DROGS.
ADMIN_EMAILS=
SITE_ACCESS_CODE=1234
ADMIN_ACCESS_CODE=
# Random secret of at least 32 characters; keep stable and private.
SESSION_SECRET=

# Email provider SMTP credentials for one-time sign-in codes.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional: "Any issues?" reports also post to a Telegram chat. Email to ADMIN_EMAILS is always sent.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Private Cloudflare R2 bucket, scoped Object Read & Write credentials.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Required when using scoped temporary credentials; renew before their expiry.
R2_SESSION_TOKEN=

# Optional public bank/MoMo instructions displayed on the payment screen.
NEXT_PUBLIC_PAYMENT_INSTRUCTIONS=
# Hostinger supplies PORT. Do not put credentials in NEXT_PUBLIC_ variables.
